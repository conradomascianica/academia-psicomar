# Base PostgreSQL propia de cada entorno. Nunca usar producción en preview.
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Solo Preview, tras comprobar que DATABASE_URL apunta a una base aislada.
PSICOMAR_PREVIEW_DATABASE_CONFIRMED=false
# Solo pruebas locales con PGlite; no activar en Vercel.
PSICOMAR_LOCAL_TEST=0

# disabled | gmail | smtp | resend. Sin configuración, la UI no simula envío.
EMAIL_PROVIDER=disabled
GMAIL_USER=psicomar.km@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Alternativa SMTP con contraseña de aplicación, no la contraseña de Gmail.
GMAIL_APP_PASSWORD=
# Proveedor heredado opcional; Gmail no requiere dominio propio.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_CONSULTAS=psicomar.km@gmail.com

# test | production; Preview admite solamente test.
MP_ENV=test
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
# Adaptador encapsulado: no activar sin QA separado de suscripciones.
MP_SUBSCRIPTIONS_ENABLED=false

# Stores DIFERENTES: imágenes públicas vs archivos pagos y comprobantes.
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
